# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.
#
# Duranium only: S-Boot -> BOOT (loader -> U-Boot) -> systemd-boot -> UKI
# with the DTB embedded, the Duranium GPT disk nested in the Android
# userdata partition. Nothing in Duranium makes a boot.img from these
# values: the installer builds the BOOT image from the boot-chain payload and
# the owner's stock boot.img (scripts/installer/lib/bootimg.sh).

deviceinfo_format_version="0"
deviceinfo_name="@DEVICE_NAME@"
deviceinfo_manufacturer="@VENDOR_NAME@"
deviceinfo_codename="@DEVICE_ID@"
deviceinfo_year=""
deviceinfo_dtb="exynos/@SOC@-@CODENAME@"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="@FORM_FACTOR@"
deviceinfo_drm="true"
deviceinfo_keyboard="false"
deviceinfo_external_storage="true"
deviceinfo_screen_width=""
deviceinfo_screen_height=""
# UFS usually has 4096-byte logical sectors: the nested GPT must match
# (check /sys/block/sda/queue/logical_block_size in the live environment)
deviceinfo_rootfs_image_sector_size="4096"

# Bootloader related. Never set a vbmeta partition here: S-Boot refuses an
# unsigned vbmeta and stays in Download mode.
deviceinfo_flash_method="heimdall-bootimg"
deviceinfo_flash_heimdall_partition_kernel="BOOT"
deviceinfo_initfs_compression="gzip"
