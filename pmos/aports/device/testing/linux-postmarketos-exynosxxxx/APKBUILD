# Mainline kernel for the @SOC_NAME@ (@DEVICE_NAME@).
#
# torvalds/linux at _base plus @CODENAME@.patch: the port's kernel branch
# (src/linux, not committed), linearised on top of _base, so base + patch is
# exactly the branch's tree at _commit. Regenerate both and the checksums
# with scripts/kernel-export after an on-device test.
#
# Kernel config: config-$_flavor.$arch, the bring-up config the device runs
# plus the postmarketOS kconfigcheck categories below and the Duranium needs
# (UKI, dm-verity, nested GPT, systemd, the USB debug gadget).
maintainer="@MAINTAINER@"
pkgname=linux-postmarketos-@SOC@
pkgver=0.0.0_git00000000
pkgrel=0
# the port's kernel branch commit that base + patch reproduces
_commit=""
# torvalds/linux commit (or tag) that @CODENAME@.patch applies to
_base=""
pkgdesc="Mainline kernel for Samsung @SOC_NAME@ devices (WIP)"
url="https://github.com/@REPO@"
arch="aarch64"
_carch="arm64"
_flavor="${pkgname#linux-}"
license="GPL-2.0-only"
options="!check !strip !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community_various
	pmb:kconfigcheck-containers
	pmb:kconfigcheck-filesystems
	pmb:kconfigcheck-immutable
	pmb:kconfigcheck-input
	pmb:kconfigcheck-nftables
	pmb:kconfigcheck-usb
	pmb:kconfigcheck-usb_gadgets
	pmb:kconfigcheck-zram
	"
makedepends="
	bash
	bc
	bison
	elfutils-dev
	findutils
	flex
	gmp-dev
	linux-headers
	mpc1-dev
	mpfr-dev
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
	"

_config="config-$_flavor.$arch"
source="
	linux-$_base.tar.gz::https://github.com/torvalds/linux/archive/$_base.tar.gz
	@CODENAME@.patch
	$_config
	"
builddir="$srcdir/linux-$_base"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make install modules_install \
		ARCH="$_carch" \
		CC="${CC:-gcc}" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr

	# Only the device's DTB: Duranium's mkosi embeds every shipped DTB in
	# the UKI (as .dtbauto sections when there are several); one DTB gives
	# an unconditional .dtb section, independent of the loader's DT.
	install -Dm644 arch/"$_carch"/boot/dts/exynos/@SOC@-@CODENAME@.dtb \
		"$pkgdir"/boot/dtbs/exynos/@SOC@-@CODENAME@.dtb

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

sha512sums="
"
