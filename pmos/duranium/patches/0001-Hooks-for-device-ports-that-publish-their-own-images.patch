From 37d322cc8224a0c26fd34bf870fe9407fa8e8963 Mon Sep 17 00:00:00 2001
From: exynos-linux <exynos-linux@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:06:15 +1100
Subject: [PATCH] Hooks for device ports that publish their own images

Small, generic hooks a downstream device port needs to build Duranium
images from its own packages without patching the core:

- scripts/pmaports.py: a symlinked pmaports checkout is used as it is
  (no fetch, switch or reset), so a local or CI tree with extra aports
  survives the build
- scripts/pmaports.py: a device package's "-initramfs" subpackage goes
  into the initrd, like the unl0kr fbforcerefresh case
- scripts/pmaports.py: DURANIUM_EXTRA_PACKAGES (comma separated) adds
  packages for one build only, e.g. a development layer that release
  images leave out; duranium-usb-debug-initramfs follows it into the
  initrd
- mkosi.conf: pass DURANIUM_EXTRA_PACKAGES to the sub-images
- mkosi.finalize: run contrib/$PMOS_DEVICE/mkosi.finalize when present
  (e.g. the port's own update server and signing key)
- scripts/mkosi-container: MKOSI_CONTAINER_ARGS for extra podman
  arguments (bind mounts for --package-directory= and a symlinked
  pmaports)
---
 mkosi.conf                     |  2 +-
 mkosi.finalize                 |  5 +++
 scripts/mkosi-container        |  6 ++++
 scripts/pmaports.py            | 44 ++++++++++++++++++++++++
 scripts/tests/test_pmaports.py | 61 ++++++++++++++++++++++++++++++++++
 5 files changed, 117 insertions(+), 1 deletion(-)

diff --git a/mkosi.conf b/mkosi.conf
index fec2e22..e3385db 100644
--- a/mkosi.conf
+++ b/mkosi.conf
@@ -6,7 +6,7 @@ Distribution=nura
 [Config]
 # Pass these PMOS_* variables so they are available in sub-images (e.g. initrd)
 # Pass the CI var so scripts can detect if they are running in gitlab CI
-PassEnvironment=PMOS_DEVICE PMOS_VARIANT CI
+PassEnvironment=PMOS_DEVICE PMOS_VARIANT CI DURANIUM_EXTRA_PACKAGES
 Dependencies=
 	base
 	dev-tools-confext
diff --git a/mkosi.finalize b/mkosi.finalize
index 2c46a0f..e42dab0 100755
--- a/mkosi.finalize
+++ b/mkosi.finalize
@@ -31,6 +31,11 @@ gpg --no-default-keyring \
    --keyring "$BUILDROOT"/usr/lib/systemd/import-pubring.pgp \
    --import pmos-sysupdate-public-key.asc
 
+# Device hook (e.g. a downstream device that publishes its own images)
+if [ -x "$SRCDIR/contrib/$PMOS_DEVICE/mkosi.finalize" ]; then
+    "$SRCDIR/contrib/$PMOS_DEVICE/mkosi.finalize"
+fi
+
 # Generate sysusers.d and tmpfiles.d config for Alpine system users
 mkdir -p "$BUILDROOT/usr/lib/sysusers.d" "$BUILDROOT/usr/lib/tmpfiles.d"
 
diff --git a/scripts/mkosi-container b/scripts/mkosi-container
index 00f2a54..6087c98 100755
--- a/scripts/mkosi-container
+++ b/scripts/mkosi-container
@@ -32,6 +32,11 @@ elif [ -n "${DISPLAY:-}" ] && [ -d /tmp/.X11-unix ]; then
     display="-v /tmp/.X11-unix:/tmp/.X11-unix -e DISPLAY=${DISPLAY} -e SDL_VIDEODRIVER=x11"
 fi
 
+# Extra podman arguments, e.g. bind mounts for --package-directory= or a
+# symlinked local pmaports checkout outside of the repository:
+#   MKOSI_CONTAINER_ARGS="-v /path/to/pkgs:/path/to/pkgs"
+extra=${MKOSI_CONTAINER_ARGS:-}
+
 # shellcheck disable=SC2086
 podman run --rm \
     --entrypoint "" \
@@ -41,5 +46,6 @@ podman run --rm \
     -w /src \
     $devices \
     $display \
+    $extra \
     "$IMAGE" \
     mkosi --workspace-dir=/workspace "$@"
diff --git a/scripts/pmaports.py b/scripts/pmaports.py
index d08fb06..689d25c 100755
--- a/scripts/pmaports.py
+++ b/scripts/pmaports.py
@@ -67,6 +67,15 @@ def prepare_pmaports(release: str, skip_fetch: bool = False) -> Path:
             raise RuntimeError(f"pmaports not found at {pmaports_dir} and --skip-fetch was given")
         return pmaports_dir
 
+    if pmaports_dir.is_symlink():
+        # A symlink means a local pmaports checkout (e.g. a git worktree on a
+        # development branch) was put in place on purpose. Never switch its
+        # branch or hard-reset it to upstream: that would throw away the
+        # local packages, or move another worktree's branch.
+        print(f"pmaports: {pmaports_dir} is a symlink to {pmaports_dir.resolve()}, "
+              "using it as is (no fetch/switch/reset)", file=sys.stderr)
+        return pmaports_dir
+
     pmaports_dir.parent.mkdir(parents=True, exist_ok=True)
     branch = "main" if release == "edge" else release
 
@@ -174,6 +183,18 @@ def pick_kernel_subpackage(apkbuild_path: str, device: str) -> Optional[str]:
     return None
 
 
+def subpackage_names(apkbuild_path: str) -> set[str]:
+    # Return the bare subpackage names (the part before ':') declared by an
+    # APKBUILD, so callers can tell whether e.g. a "-initramfs" subpackage
+    # exists without parsing the function names.
+    result = subprocess.run(
+        ["sh", "-c", f". '{apkbuild_path}' && echo $subpackages"],
+        capture_output=True,
+        check=True,
+    )
+    return {entry.split(":")[0] for entry in result.stdout.decode("utf-8").split()}
+
+
 def find_deviceinfo(pmaports_dir: Path, device: str) -> Path:
     for subdir in ("main", "community", "testing"):
         candidate = pmaports_dir / "device" / subdir / f"device-{device}" / "deviceinfo"
@@ -222,7 +243,30 @@ def resolve(device: str, ui: str, release: str, skip_fetch: bool = False) -> dic
         packages.append("postmarketos-buffybox-f0rmz-fbforcerefresh")
         initrd_packages.append("postmarketos-buffybox-unl0kr-fbforcerefresh")
 
+    # A device package may ship a "-initramfs" subpackage with early-boot
+    # support (USB prep, nested-GPT udev rules, watchdog config). pmaports has
+    # no general way to mark a package as initramfs-only, so infer it from the
+    # subpackage naming, mirroring the unl0kr-fbforcerefresh case above.
+    device_subpkgs = subpackage_names(str(device_apkbuild))
+    if f"{device_pkg}-initramfs" in device_subpkgs:
+        initrd_packages.append(f"{device_pkg}-initramfs")
+
+    # Extra packages for this build only (comma separated: mkosi's
+    # --environment= splits its value at whitespace), e.g. a development
+    # layer that release images of the same device leave out.
+    extra = os.environ.get("DURANIUM_EXTRA_PACKAGES", "").replace(",", " ").split()
+    packages += extra
+
+    # The Duranium USB debug layer (duranium-usb-debug) must also be in the
+    # initrd so pre-switch-root failures are debuggable over USB. It ships a
+    # "-initramfs" subpackage with just the interface + console. It comes
+    # either as a hard dependency of the device package (so apk pulls the
+    # base part in on its own) or as an extra package of a development build.
+    if "duranium-usb-debug" in device_depends or "duranium-usb-debug" in extra:
+        initrd_packages.append("duranium-usb-debug-initramfs")
+
     packages = list(dict.fromkeys(packages))
+    initrd_packages = list(dict.fromkeys(initrd_packages))
 
     # create mkosi-compatible json config fragment
     out: dict = {"Architecture": mkosi_arch}
diff --git a/scripts/tests/test_pmaports.py b/scripts/tests/test_pmaports.py
index c497ea3..2a9f84f 100644
--- a/scripts/tests/test_pmaports.py
+++ b/scripts/tests/test_pmaports.py
@@ -270,3 +270,64 @@ def test_resolve_missing_device(mock_prepare, tmp_path):
 
     with pytest.raises(RuntimeError, match="deviceinfo not found"):
         pm.resolve("testphone", "testui", "edge")
+
+
+@unittest.mock.patch("pmaports.prepare_pmaports")
+def test_resolve_device_initramfs_subpackage(mock_prepare, tmp_path):
+    # a device "-initramfs" subpackage goes into the initrd, not the base image
+    pmaports_dir = make_fake_pmaports(
+        tmp_path, device="testphone", ui="testui",
+        device_subpackages="device-testphone-initramfs:initramfs",
+    )
+    mock_prepare.return_value = pmaports_dir
+
+    result = pm.resolve("testphone", "testui", "edge")
+    assert result["InitrdPackages"] == ["device-testphone-initramfs"]
+    assert "device-testphone-initramfs" not in result["Packages"]
+
+
+@unittest.mock.patch("pmaports.prepare_pmaports")
+def test_resolve_usb_debug_initramfs(mock_prepare, tmp_path):
+    pmaports_dir = make_fake_pmaports(
+        tmp_path, device="testphone", ui="testui",
+        device_depends="duranium-usb-debug",
+        device_subpackages="device-testphone-initramfs:initramfs",
+    )
+    mock_prepare.return_value = pmaports_dir
+
+    result = pm.resolve("testphone", "testui", "edge")
+    assert result["InitrdPackages"] == [
+        "device-testphone-initramfs", "duranium-usb-debug-initramfs"]
+
+
+def test_prepare_pmaports_symlink_is_left_alone(tmp_path, monkeypatch):
+    # a symlinked local pmaports checkout must never be switched or reset
+    repo = tmp_path / "repo"
+    (repo / "scripts").mkdir(parents=True)
+    local = tmp_path / "local-pmaports"
+    local.mkdir()
+    (repo / "pmaports").symlink_to(local)
+    monkeypatch.setattr(pm, "__file__", str(repo / "scripts" / "pmaports.py"))
+
+    def no_git(*args, **kwargs):
+        raise AssertionError(f"unexpected subprocess call {args}")
+
+    monkeypatch.setattr(pm.subprocess, "run", no_git)
+    assert pm.prepare_pmaports("edge") == repo / "pmaports"
+
+
+@unittest.mock.patch("pmaports.prepare_pmaports")
+def test_resolve_extra_packages_usb_debug(mock_prepare, tmp_path, monkeypatch):
+    # a development build adds the debug layer that the device leaves out
+    pmaports_dir = make_fake_pmaports(
+        tmp_path, device="testphone", ui="testui",
+        device_subpackages="device-testphone-initramfs:initramfs",
+    )
+    mock_prepare.return_value = pmaports_dir
+    monkeypatch.setenv("DURANIUM_EXTRA_PACKAGES", "duranium-usb-debug,duranium-usb-debug-adb")
+
+    result = pm.resolve("testphone", "testui", "edge")
+    assert "duranium-usb-debug" in result["Packages"]
+    assert "duranium-usb-debug-adb" in result["Packages"]
+    assert result["InitrdPackages"] == [
+        "device-testphone-initramfs", "duranium-usb-debug-initramfs"]
-- 
2.56.0

