#!/bin/bash
# Set up the build trees in $WORK (default ./build/work) from upstream plus
# what we maintain:
#
#   $WORK/duranium-build   upstream duranium-build main
#                          + pmos/duranium/patches/*.patch (generic hooks;
#                            falls back to pmos/duranium/BASE when upstream
#                            moved in a way that conflicts)
#                          + pmos/duranium/contrib/ as contrib/<device.id>/
#                            with config.env (the resolved config.toml) and
#                            the signing key's public half
#   $WORK/pmaports         upstream pmaports main + pmos/aports/ (only new
#                          aports: upstream ones are never replaced)
#
# Everything else (the whole userspace, the UIs) comes from the
# postmarketOS binary repositories at image build time. CI and local builds
# (scripts/build-image) both start here.
set -euo pipefail
cd "$(dirname "$0")/.."
P=$PWD
eval "$(scripts/config shell)"
WORK=${WORK:-$P/build/work}
mkdir -p "$WORK"
note() { echo "::notice::$*"; }
warn() { echo "::warning::$*"; }

git_id() { git -C "$1" -c user.name="$CFG_PROJECT_NAME CI" -c user.email=ci@invalid "${@:2}"; }

D=$WORK/duranium-build
rm -rf "$D"
git clone -q "$CFG_UPSTREAM_DURANIUM_BUILD" "$D"
shopt -s nullglob
patches=("$P"/pmos/duranium/patches/*.patch)
if [ ${#patches[@]} = 0 ]; then
	note "duranium-build: upstream $(git -C "$D" rev-parse --short HEAD), no patches"
elif git_id "$D" am -q --3way "${patches[@]}"; then
	note "duranium-build: ${#patches[@]} patches on upstream $(git -C "$D" rev-parse --short origin/main)"
else
	git_id "$D" am --abort || true
	base=$(cat "$P/pmos/duranium/BASE")
	warn "duranium-build: our patches do not apply on upstream $(git -C "$D" rev-parse --short origin/main); building on $base. Rebase pmos/duranium/patches."
	git -C "$D" checkout -q "$base"
	git_id "$D" am -q "${patches[@]}"
fi

C=$D/contrib/$CFG_DEVICE_ID
[ ! -e "$C" ] || { echo "upstream duranium-build now has contrib/$CFG_DEVICE_ID: merge ours into it" >&2; exit 1; }
mkdir -p "$D/contrib"
cp -r "$P/pmos/duranium/contrib" "$C"
cp "$P/$CFG_UPDATE_PUBLIC_KEY" "$C/sysupdate-public-key.asc"
scripts/config shell > "$C/config.env"
scripts/config channels > "$C/channels"
cp "$P/pmos/aports/BUILD" "$C/BUILD"

A=$WORK/pmaports
rm -rf "$A"
git clone -q --depth 1 "$CFG_UPSTREAM_PMAPORTS" "$A"
(cd "$P/pmos/aports" && find . -name APKBUILD -printf '%h\n') | sort | while read -r d; do
	d=${d#./}
	[ ! -e "$A/$d" ] || { echo "upstream pmaports now has $d: drop ours or rename it" >&2; exit 1; }
	mkdir -p "$A/$(dirname "$d")"
	cp -r "$P/pmos/aports/$d" "$A/$d"
done
note "pmaports: upstream $(git -C "$A" rev-parse --short HEAD) + $(find "$P/pmos/aports" -name APKBUILD | wc -l) aports of ours"
# the image build reads which UI/device packages to install from here; it
# must not fetch or reset it (the pmaports.py patch leaves a symlink alone)
ln -sfn "$A" "$D/pmaports"

{
	echo "duranium_build=$(git -C "$D" rev-parse HEAD)"
	echo "pmaports=$(git -C "$A" rev-parse HEAD)"
} >> "${GITHUB_OUTPUT:-/dev/null}"
